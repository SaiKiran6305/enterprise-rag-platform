APP_NAME=Enterprise Knowledge AI Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=enterprise_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag_user:replace-with-local-password@localhost:5432/enterprise_rag
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=replace-with-openai-api-key
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
